# --- Bedrock auth (Sai uses Claude Code via AWS Bedrock — no Anthropic API key) ---
# Standard AWS credential chain works (env vars, ~/.aws/credentials, SSO, role).
# These three are the most common explicit override:
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=
# AWS_PROFILE=                 # alternative to access keys

# Bedrock model ID for tailoring. Bedrock IDs are prefixed with `anthropic.`
# Examples: anthropic.claude-opus-4-7, anthropic.claude-sonnet-4-6
TAILOR_MODEL=anthropic.claude-sonnet-4-6

# Where to find the resume variants on disk
RESUMES_DIR=C:/Users/sai.jayanthi/OneDrive - Kuehne+Nagel/Documents/resumes

# Where the pipeline writes data, scored jobs, tailored resumes, the SQLite db
DATA_DIR=./data
OUTPUT_DIR=./output

# Visa floor used by the scorer (Graduate -> Skilled Worker switcher, 2026 rules)
VISA_SALARY_FLOOR_GBP=33400
TARGET_SOC_FLOOR_GBP=38290

# Optional: proxy URL JobSpy will route through (recommended for LinkedIn)
JOBSPY_PROXY=

# Adzuna (free) — sign up at https://developer.adzuna.com to get app_id/app_key.
# 250 calls/day free tier is plenty for daily ingest. Without these the
# adzuna source quietly returns 0 rows; everything else still works.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

